# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Python packaging artifacts
*.egg-info/
build/
dist/

# Environments
.env
.venv/
venv/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# IDE & OS
.vscode/
.idea/
.DS_Store

# Benchmark datasets (downloaded, not vendored)
benchmarks/data/

# SWE-bench local repo clones and Docker eval logs (large, not vendored)
~/.cache/swebench-repos/
logs/run_evaluation/
*.jsonl

# Benchmark live-run reports (timestamped artifacts)
reports/benchmark_report_*.json
reports/benchmark_report_*.md

# Throwaway benchmark smoke/proto artifacts (regenerate, don't vendor)
benchmarks/results/*smoke*
benchmarks/results/*repro*
benchmarks/results/*_preds.jsonl
benchmarks/results/*requests*.json

# Node / editor / OS junk
node_modules/
*.swp
Thumbs.db

# Local graph-agent working file (changes every run; not source of truth)
gbas-agent.gbas_agent_v5.json

# META-SYSTEM measurement log (append-only runtime evidence; not source)
system/measurements/

# Local verified benchmark results (regenerate, do not vendor)
benchmarks/results/swebench_verified_local.json

# Local benchmark/build logs (large side-effects, not source)
logs/

# Local Hermes agent state (plans, session dumps — not source)
.hermes/
